
# --- App / runtime ---
ENVIRONMENT=dev
APP_NAME="Student Study Chatbot"

# --- Storage (relative paths are resolved against the repo root) ---
UPLOADS_DIR=data/uploads
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION=study_docs

# --- Retrieval ---
TOP_K=4

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Embeddings ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# --- LLM (Transformers) ---
LLM_MODEL_NAME=google/flan-t5-base
LLM_DEVICE=cpu
MAX_NEW_TOKENS=256
TEMPERATURE=0.0

# --- CORS ---
# Use "*" for easiest local dev. In production, set to your Streamlit origin, e.g.:
# CORS_ALLOW_ORIGINS=https://your-space-name.hf.space
CORS_ALLOW_ORIGINS=*

# --- Streamlit UI ---
# Streamlit reads environment variables directly; this helps local runs.
API_BASE_URL=http://localhost:8000