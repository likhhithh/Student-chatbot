
# --- App / runtime ---
ENVIRONMENT=dev
APP_NAME="Student Study Chatbot"

# --- Storage (relative paths are resolved against the repo root) ---
UPLOADS_DIR=data/uploads
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION=study_docs_bedrock

# --- Retrieval ---
TOP_K=4

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- CORS ---
# Use "*" for easiest local dev. In production, set to your React origin.
CORS_ALLOW_ORIGINS=*

# ─── AWS Bedrock ───────────────────────────────────────────────────────────────
# Option 1: Explicit credentials (paste your IAM user keys here)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# Option 2: Leave blank to use default AWS credential chain
#   (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars, ~/.aws/credentials, or IAM role)

# ─── Bedrock Model IDs ─────────────────────────────────────────────────────────
# LLM — OpenAI GPT on Bedrock (must be enabled in your Bedrock console)
BEDROCK_CHAT_MODEL_ID=openai.gpt-oss-120b-1:0

# Embeddings — Amazon Titan Text V2  (1024-dim, no extra enablement needed)
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0